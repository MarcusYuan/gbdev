{
  "schema": "gbdev.pipeline-request.v1",
  "request_id": "pr_smoke_s2",
  "pipeline": "review-only",
  "repo": "/path/to/gbdev-smoke",
  "base_ref": "REPLACE_WITH_S1_BRANCH",
  "diff_base_ref": "master",
  "goal": "只读审查 S1 分支相对 master 的 sum(a,b) 实现及测试；输出结构化 review verdict/findings。",
  "context": "此仓库由调度者预先准备：干净、有初始提交，npm test 可离线运行。",
  "constraints": [
    "不添加依赖、不联网",
    "只在 allowed_paths 内改动",
    "不要 git add/commit，由 gbdev snapshot"
  ],
  "allowed_paths": [
    "src/**",
    "test/**"
  ],
  "acceptance_criteria": [
    {
      "id": "AC1",
      "text": "sum(a,b) 正确计算两个数字之和，有覆盖正数、负数和零的测试",
      "check_cmd": "npm test"
    }
  ],
  "required_evidence": [
    "tests",
    "diff_summary"
  ],
  "step_overrides": {},
  "max_rounds": 2,
  "timeout_min": 240,
  "max_total_jobs": 12,
  "network": false
}
